# ==============================================================================
# axis_video_mixer: the whole block, register file included.
#
#   sby -f fv_top.sby
#
# Tasks:
#   bmc     AXI4-Lite protocol compliance, interrupt behaviour, the flattening
#           of the stream ports, and bounded response latency on the control
#           port, 20 cycles from reset
#   prove   the same, unbounded, by k-induction
#   cover   software can actually reach the datapath: a write enables the
#           mixer, a layer joins the composite, a frame comes out, and an error
#           bit is raised and then cleared
#
# The datapath properties are deliberately NOT re-run here. fv_core.sby proves
# them with the configuration completely free, which is a strictly harsher
# environment than one reached through a register file -- the register block
# cannot produce a configuration the core has not already been proved to
# handle. What is left for this level is the control port, the interrupt, and
# the wiring between.
#
# P_NUM_LAYERS is four here and two in fv_core.sby, because the generated
# register map is built for four and the CSR adapter refuses anything else.
# ==============================================================================

[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 20
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 40

[engines]
smtbmc boolector

[script]
plugin -i slang
prove: read_slang --top fv_top -G FV_CHECK_BOUNDED=0 axis_video_mixer_pkg.sv axis_video_mixer_regs.v axis_video_mixer_csr.sv axis_mixer_fifo.sv axis_mixer_layer.sv axis_video_mixer_core.sv axis_video_mixer.sv fv_axil_props.sv fv_axil_bind.sv fv_top.sv
~prove: read_slang --top fv_top axis_video_mixer_pkg.sv axis_video_mixer_regs.v axis_video_mixer_csr.sv axis_mixer_fifo.sv axis_mixer_layer.sv axis_video_mixer_core.sv axis_video_mixer.sv fv_axil_props.sv fv_axil_bind.sv fv_top.sv
prep -top fv_top

[files]
../src/axis_video_mixer_pkg.sv
../src/generated/axis_video_mixer_regs.v
../src/generated/axis_video_mixer_csr.sv
../src/axis_mixer_fifo.sv
../src/axis_mixer_layer.sv
../src/axis_video_mixer_core.sv
../src/axis_video_mixer.sv
props/fv_axil_props.sv
props/fv_axil_bind.sv
tops/fv_top.sv
