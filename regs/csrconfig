[globcfg]
base_address = 0
data_width = 32
address_width = 12
register_reset = sync_neg
address_increment = none
address_alignment = data_width
force_name_case = none
regmap_path = regs.json

[v_module]
path = ../src/generated/axis_video_mixer_regs.v
read_filler = 0
interface = axil
generator = Verilog

[c_header]
path = ../sw/axis_video_mixer_regs.h
prefix = MIXER
generator = CHeader

[md_doc]
path = ../doc/axis_video_mixer_regs.md
title = AXI4-Stream video mixer register map
print_images = False
print_conventions = True
generator = Markdown
