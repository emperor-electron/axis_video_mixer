# Simulation and synthesis artifacts. Everything a tool regenerates.
tb/xsim.dir/
tb/*.log
tb/*.jou
tb/*.pb
tb/*.wdb
tb/*.vcd
tb/*.str
tb/xsim.covdb/
tb/.Xil/

# Verilator output from the smoke scenarios. The .sv and the Makefile are
# checked in; everything Verilator generates from them is not.
tb/smoke/obj_dir/

# SymbiYosys output. One directory per task, plus a status database per .sby
# file, all regenerated by `make -C formal`. Checked in instead: the .sby
# files, formal/props/, formal/tops/, the Makefile and the README -- those are
# the proofs.
formal/fv_*/

syn/*.log
syn/*.jou
syn/*.rpt
syn/.Xil/
syn/vivado*.str

# Not ignored, and deliberately so: src/generated/ and sw/ and doc/ are checked
# in. They are generated, but a consumer of this IP must be able to build it
# without installing corsair, and the C header is what software is written
# against. Regenerate them with regs/gen_regs.py plus corsair; do not edit.
